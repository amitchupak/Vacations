                  "const json = pm.response.json();",
                  "if (json && json._id) pm.collectionVariables.set('vacationId', json._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "destination", "value": "Postman Test Destination", "type": "text" },
                { "key": "description", "value": "Created automatically by the Postman collection.", "type": "text" },
                { "key": "startDate", "value": "2026-06-01", "type": "text" },
                { "key": "endDate", "value": "2026-06-10", "type": "text" },
                { "key": "price", "value": "1499.99", "type": "text" },
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Required. Pick any image file from your machine before sending."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/vacations",
              "host": ["{{base_url}}"],
              "path": ["api", "vacations"]
            },
            "description": "Admin only. Multipart with an `image` file. Run Login as admin first."
          }
        },
        {
          "name": "Update Vacation",
          "event": [
